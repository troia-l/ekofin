# Gerçek değerleri backend/.env dosyasına yazın; bu dosyaya anahtar koymayın.

# ─── 1. Google Gemini API (OpenAI Uyumluluk Katmanı) ───
# Kaynak: https://ai.google.dev/gemini-api/docs/openai?hl=tr
# Google AI Studio'dan alınan Gemini API anahtarınızı (AIzaSy...) buraya yazın.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash

# ─── 2. OpenAI API (TSRS Rapor Pipeline ve Analiz) ───
# İsteğe bağlıdır. Eğer OpenAI yerine tüm sistemi Gemini ile çalıştırmak isterseniz:
# OPENAI_API_KEY alanına Gemini anahtarınızı, OPENAI_API_BASE alanına
# https://generativelanguage.googleapis.com/v1beta/openai/ ve model olarak gemini-2.5-flash yazabilirsiniz.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TSRS_MODEL=gpt-5.4
OPENAI_GROI_MODEL=gpt-5.4
OPENAI_ESG_MODEL=gpt-5.4

# ─── 3. Özel NLP & Haber/Duygu Analizi API (İsteğe Bağlı) ───
# NLP modülünün yukarıdaki anahtarlardan farklı bir anahtar kullanmasını isterseniz:
NLP_GEMINI_API_KEY=
NLP_OPENAI_API_KEY=
NLP_OPENAI_API_BASE=

# Yalnız bilinçli canlı test için 1 yapın; varsayılan kapalıdır.
RUN_LIVE_LLM_TESTS=0
